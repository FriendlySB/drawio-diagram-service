# draw.io Diagram Service -- environment template
#
# Copy to .env and replace the placeholder credentials. The server REFUSES TO START while they are
# still the values below, so a copied template cannot go live unprotected.

# --- Server ---
PORT=5100

# --- Authentication ---
# The single shared credential ServeAI uses to reach this service. Prefixed because a ServeAI
# deployment also carries CLIENT_ID/CLIENT_SECRET for the OfficeCLI Server, and two services sharing
# one variable name in one compose file is a mix-up waiting to happen.
DRAWIO_CLIENT_ID=your_client_id
DRAWIO_CLIENT_SECRET=your_client_secret

# --- Storage ---
# Per-conversation working copies: {STORAGE_ROOT}/{chatId}/{fileId}.xml plus a .json sidecar.
STORAGE_ROOT=/tmp/serveAI-drawio

# How long a conversation may sit idle before its diagrams are swept. There is no delete endpoint,
# so this is the ONLY path by which storage is ever reclaimed.
TEMP_TTL_HOURS=24

# Ceiling on diagrams per conversation. With no delete endpoint, this is what stops an agent looping
# on /diagram/create from filling the disk before the next sweep.
MAX_DIAGRAMS_PER_CHAT=20

# Maximum JSON body. Diagram XML travels as a string field.
MAX_BODY_SIZE=10mb

# --- Renderer (draw-image-export2) ---
# MUST NOT be network-exposed: it has no authentication, CORS *, and launches a fresh Chrome per
# request. Private network or loopback only; this service is the only thing that should reach it.
RENDER_SERVICE_URL=http://localhost:8000

# Deliberately ABOVE the renderer's own 30s Chrome kill. Aborting first only abandons renders that
# were about to succeed while Chrome burns the CPU anyway.
RENDER_TIMEOUT_MS=35000

# White, not transparent. The renderer omits the background for a PNG when this is unset, and a
# transparent PNG with dark text is invisible in a dark-mode chat.
RENDER_BACKGROUND=#ffffff

RENDER_SCALE=2
RENDER_BORDER=10

# --- Validation ---
# Cross-check style references against the shape index during validation. Warnings only; it never
# rejects a diagram. Set to 0 to switch off.
SHAPE_CHECK_ENABLED=1
