// Compiles ONLY the five vendored next-ai-draw-io modules (src/*.ts) to CommonJS
// in dist/vendor/. The service itself is plain CommonJS JavaScript and is never
// compiled -- `include` below is deliberately non-recursive so our own .js files
// and the generated shape index are not dragged in.
{
    "compilerOptions": {
        // DO NOT add a `lib` field. Its absence is load-bearing: target ES2022 with
        // no lib resolves to lib.es2022.full.d.ts, which includes the DOM types. The
        // vendored files reference DOMParser, XMLSerializer, Document and Element,
        // so setting "lib": ["ES2022"] breaks all five.
        "target": "ES2022",
        // With module Node16, tsc picks the emit format per file from the nearest
        // package.json `type`. Ours says "commonjs", so these ESM-syntax sources emit
        // CommonJS with zero edits -- their "./pages.js" specifiers become require().
        "module": "Node16",
        "moduleResolution": "Node16",
        "outDir": "./dist/vendor",
        "rootDir": "./src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "resolveJsonModule": true,
        "types": ["node"]
    },
    // Non-recursive on purpose: only the five vendored modules, plus the local
    // linkedom ambient declaration (a .d.ts emits no .js, so dist/vendor stays clean).
    "include": ["src/*.ts", "types/*.d.ts"],
    "exclude": ["node_modules", "dist"]
}
